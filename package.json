{
  "name": "bordful",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bordful": "payload bordful",
    "build": "next build",
    "check": "bun run typecheck && bun run lint && bun run test && bun run lint:payload",
    "dev": "next dev",
    "format": "ultracite fix",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "ultracite check",
    "lint:payload": "bun scripts/check-override-access.ts",
    "payload": "payload",
    "seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-presigned-post": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@payloadcms/db-postgres": "4.0.0-beta.6",
    "@payloadcms/email-resend": "4.0.0-beta.6",
    "@payloadcms/next": "4.0.0-beta.6",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.6",
    "@payloadcms/richtext-lexical": "4.0.0-beta.6",
    "@payloadcms/storage-vercel-blob": "4.0.0-beta.6",
    "@payloadcms/transformer-sharp": "^4.0.0-beta.7",
    "@payloadcms/ui": "4.0.0-beta.6",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.22",
    "botid": "1.5.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "files-sdk": "^3.1.3",
    "graphql": "16.15.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "parse5": "8.1.0",
    "payload": "4.0.0-beta.6",
    "pg": "8.20.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "resend": "6.37.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
