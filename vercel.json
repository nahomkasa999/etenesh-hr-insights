{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/expire",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "0 8 * * *"
    }
  ],
  "buildCommand": "NODE_ENV=production bun run seed:etenesh && bun run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "demo.bordful.com"
        }
      ],
      "destination": "https://bordful.com/jobs",
      "statusCode": 301
    }
  ]
}
